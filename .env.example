# Aplicação
NODE_ENV=development
APP_NAME=Gestão de Clubes
APP_URL=http://localhost:4002
API_URL=http://localhost:4003
# URL pública acessível pelo Asaas, sem ou com o sufixo /api
PUBLIC_API_URL=http://localhost:4003
API_INTERNAL_URL=http://localhost:4003/api
API_DOCKER_INTERNAL_URL=http://api:4003/api
API_PORT=4003
CORS_ORIGINS=http://localhost:4002

# Banco de dados
POSTGRES_DB=club_platform
POSTGRES_USER=club
POSTGRES_PASSWORD=club
POSTGRES_PORT=5432
DATABASE_URL=postgresql://club:club@localhost:5432/club_platform
DATABASE_INTERNAL_URL=postgresql://club:club@postgres:5432/club_platform
DATABASE_SSL=false
TYPEORM_LOGGING=false

# Redis / filas
REDIS_URL=redis://localhost:6379/0
REDIS_INTERNAL_URL=redis://redis:6379/0
WEBHOOK_WORKER_CONCURRENCY=10
WEBHOOK_WORKER_RATE_LIMIT=100
INTERNAL_WORKER_TOKEN=replace-with-a-long-random-token

# Autenticação e criptografia
JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# 32 bytes em hexadecimal: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# Asaas por unidade
ASAAS_PRODUCTION_URL=https://api.asaas.com/v3
ASAAS_SANDBOX_URL=https://api-sandbox.asaas.com/v3
ASAAS_MOCK=true
ASAAS_WEBHOOK_ALERT_EMAIL=
ASAAS_REQUEST_TIMEOUT_MS=12000
ASAAS_FORCE_IPV4=false

# Seed inicial
SEED_ADMIN_NAME=Administrador da instalação
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_UNIT_NAME=Matriz
SEED_UNIT_SLUG=matriz

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PRODUCT_NAME=Gestão de Clubes
NEXT_PUBLIC_DEFAULT_UNIT_SLUG=matriz
NEXT_PUBLIC_UNIT_ID=matriz
